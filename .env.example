# Copie apenas as variáveis necessárias para o ambiente do sistema.
# A aplicação não carrega automaticamente este ficheiro.
OPENAI_API_KEY=
IAEDU_API_KEY=
# Fornecedor predefinido no formulário inicial: OpenAI ou IAedu.
COERIA_APP_VERSION=0.2.1
COERIA_AI_PROVIDER=OpenAI
# Caminho persistente recomendado no servidor.
COERIA_DATABASE_PATH=
# Autenticação obrigatória por omissão. Use "disabled" apenas no arranque local.
COERIA_AUTH_MODE=required
COERIA_ACCESS_FILE=
COERIA_STORAGE_SECRET=
NICEGUI_STORAGE_PATH=
# O endpoint e o canal abaixo podem ser substituídos sem alterar o código.
COERIA_IAEDU_ENDPOINT=https://api.iaedu.pt/agent-chat//api/v1/agent/cmor5objoex9gfp01vm7p95jh/stream
COERIA_IAEDU_CHANNEL_ID=cmr3ugyxf3ahjke0190ik6n4z
COERIA_IAEDU_AGENT_NAME=Agente IAedu
COERIA_IAEDU_TIMEOUT_SECONDS=120
COERIA_IAEDU_MAX_RETRIES=2
COERIA_OPENAI_MODEL=gpt-4o-mini
# Por omissão, a mesma variante é usada também nos recursos educativos.
COERIA_OPENAI_RESOURCE_MODEL=gpt-4o-mini
COERIA_OPENAI_REASONING_EFFORT=minimal
COERIA_OPENAI_TIMEOUT_SECONDS=120
COERIA_OPENAI_MAX_RETRIES=2
COERIA_OPENAI_VALIDATION_RETRIES=2
COERIA_OPENAI_MAX_OUTPUT_TOKENS=12000
# Geração opcional de imagens para apresentações (requer consentimento no formulário).
COERIA_OPENAI_IMAGE_MODEL=gpt-image-2
COERIA_OPENAI_IMAGE_SIZE=1536x864
COERIA_OPENAI_IMAGE_QUALITY=low
COERIA_OPENAI_IMAGE_MAX_PER_PRESENTATION=2
# Ciclo agentic gerador–crítico. O crítico nunca substitui a aprovação do docente.
COERIA_AGENTIC_CRITIC_ENABLED=true
COERIA_AGENTIC_MAX_REVISIONS=1
COERIA_AGENTIC_CRITIC_STAGES=learning_outcomes,outcome_taxonomy,assessment_activities,teaching_activities,alignment_matrix
COERIA_OPENAI_CRITIC_MODEL=gpt-4o-mini
COERIA_OPENAI_CRITIC_MAX_OUTPUT_TOKENS=2500
COERIA_OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=2500
COERIA_RESOURCE_QUALITY_MAX_REVISIONS=1
COERIA_MAX_SOURCE_CHARS=120000
COERIA_MAX_FILE_BYTES=12582912
