# Copie apenas as variáveis necessárias para o ambiente do sistema.
# A aplicação não carrega automaticamente este ficheiro.
OPENAI_API_KEY=
IAEDU_API_KEY=
# Fornecedor predefinido no formulário inicial: OpenAI ou IAedu.
COERIA_APP_VERSION=0.2.8
COERIA_AI_PROVIDER=OpenAI
# Caminho persistente recomendado no servidor.
COERIA_DATABASE_PATH=
# Autenticação obrigatória por omissão. Use "disabled" apenas no arranque local.
COERIA_AUTH_MODE=required
COERIA_ACCESS_FILE=
COERIA_STORAGE_SECRET=
NICEGUI_STORAGE_PATH=
# O endpoint e o canal abaixo podem ser substituídos sem alterar o código.
COERIA_IAEDU_ENDPOINT=https://api.iaedu.pt/agent-chat//api/v1/agent/cmor5objoex9gfp01vm7p95jh/stream
COERIA_IAEDU_CHANNEL_ID=cmr3ugyxf3ahjke0190ik6n4z
COERIA_IAEDU_AGENT_NAME=Agente IAedu
COERIA_IAEDU_TIMEOUT_SECONDS=120
COERIA_IAEDU_MAX_RETRIES=2
COERIA_OPENAI_MODEL=gpt-4o-mini
# Por omissão, a mesma variante é usada também nos recursos educativos.
COERIA_OPENAI_RESOURCE_MODEL=gpt-4o-mini
COERIA_OPENAI_REASONING_EFFORT=minimal
COERIA_OPENAI_TIMEOUT_SECONDS=120
COERIA_OPENAI_MAX_RETRIES=2
COERIA_OPENAI_VALIDATION_RETRIES=2
COERIA_OPENAI_MAX_OUTPUT_TOKENS=12000
# Geração de imagens para apresentações, permitida por defeito na nova sessão.
COERIA_OPENAI_IMAGE_MODEL=gpt-image-2
COERIA_OPENAI_IMAGE_SIZE=1536x864
COERIA_OPENAI_IMAGE_QUALITY=low
COERIA_OPENAI_IMAGE_MAX_PER_PRESENTATION=2
# Gerações adicionais pedidas explicitamente durante a edição da apresentação.
COERIA_OPENAI_IMAGE_MAX_ADDITIONAL_EDITOR=2
# Limite da imagem carregada diretamente no editor (20 MB).
COERIA_PRESENTATION_IMAGE_UPLOAD_MAX_BYTES=20971520
# Ciclo agentic gerador–crítico. O crítico nunca substitui a aprovação do docente.
COERIA_AGENTIC_CRITIC_ENABLED=true
COERIA_AGENTIC_MAX_REVISIONS=1
COERIA_AGENTIC_CRITIC_STAGES=learning_outcomes,teaching_activities,assessment_activities,alignment_matrix
COERIA_OPENAI_CRITIC_MODEL=gpt-4o-mini
COERIA_OPENAI_CRITIC_MAX_OUTPUT_TOKENS=2500
COERIA_OPENAI_ASSISTANT_MAX_OUTPUT_TOKENS=2500
COERIA_RESOURCE_QUALITY_MAX_REVISIONS=1
# Orçamento máximo entregue ao pipeline pedagógico depois da redução automática.
COERIA_MAX_SOURCE_CHARS=120000
# Limite absoluto de ingestão antes da redução (2 milhões de caracteres).
COERIA_MAX_RAW_SOURCE_CHARS=2000000
# Blocos usados para reduzir fontes extensas com o fornecedor selecionado.
COERIA_SOURCE_REDUCTION_CHUNK_CHARS=80000
COERIA_SOURCE_REDUCTION_MAX_OUTPUT_TOKENS=2200
COERIA_SOURCE_REDUCTION_MAX_PASSES=3
# Ficheiros de apoio: 50 MB por ficheiro e 100 MB no conjunto antes de iniciar.
COERIA_MAX_FILE_BYTES=52428800
COERIA_MAX_TOTAL_UPLOAD_BYTES=104857600

# Catálogo visual documental: exame completo, filtragem e seleção equilibrada.
COERIA_MAX_EXTRACTED_IMAGES=30
COERIA_MAX_EXTRACTED_IMAGE_BYTES=5242880
COERIA_MIN_EXTRACTED_IMAGE_WIDTH=240
COERIA_MIN_EXTRACTED_IMAGE_HEIGHT=160
COERIA_MIN_IMAGE_FOOTPRINT_WIDTH_PT=72
COERIA_MIN_IMAGE_FOOTPRINT_HEIGHT_PT=54
COERIA_PDF_COMPOSITE_GAP_PT=18
COERIA_PDF_RENDER_SCALE=2.0

# Compilação opcional dos documentos LaTeX para PDF durante a exportação.
# Requer pdflatex no sistema; mantenha desativada no desenvolvimento sem TeX Live.
COERIA_LATEX_PDF_ENABLED=false
COERIA_LATEX_COMPILER=pdflatex
COERIA_LATEX_TIMEOUT_SECONDS=45
