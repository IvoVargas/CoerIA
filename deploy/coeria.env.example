# Copiar para /etc/coeria/coeria.env, preencher no servidor e aplicar modo 0640.
OPENAI_API_KEY=
IAEDU_API_KEY=
COERIA_APP_VERSION=0.2.8
COERIA_AI_PROVIDER=OpenAI
COERIA_DATABASE_PATH=/var/lib/coeria/data/prism.db
COERIA_AUTH_MODE=required
COERIA_ACCESS_FILE=/etc/coeria/access.json
COERIA_STORAGE_SECRET=
NICEGUI_STORAGE_PATH=/var/lib/coeria/nicegui

# Modelo textual OpenAI usado por toda a aplicação.
COERIA_OPENAI_MODEL=gpt-4o-mini
COERIA_OPENAI_RESOURCE_MODEL=gpt-4o-mini
COERIA_OPENAI_CRITIC_MODEL=gpt-4o-mini
COERIA_OPENAI_REASONING_EFFORT=minimal

# Fontes documentais extensas: ingestão bruta e redução automática antes do pipeline.
COERIA_MAX_SOURCE_CHARS=120000
COERIA_MAX_RAW_SOURCE_CHARS=2000000
COERIA_SOURCE_REDUCTION_CHUNK_CHARS=80000
COERIA_SOURCE_REDUCTION_MAX_OUTPUT_TOKENS=2200
COERIA_SOURCE_REDUCTION_MAX_PASSES=3

# Geração opcional de imagens para apresentações (requer consentimento no formulário).
COERIA_OPENAI_IMAGE_MODEL=gpt-image-2
COERIA_OPENAI_IMAGE_SIZE=1536x864
COERIA_OPENAI_IMAGE_QUALITY=low
COERIA_OPENAI_IMAGE_MAX_PER_PRESENTATION=2
COERIA_OPENAI_IMAGE_MAX_ADDITIONAL_EDITOR=2
COERIA_PRESENTATION_IMAGE_UPLOAD_MAX_BYTES=20971520

# Ficheiros de apoio: 50 MB por ficheiro e 100 MB no conjunto.
COERIA_MAX_FILE_BYTES=52428800
COERIA_MAX_TOTAL_UPLOAD_BYTES=104857600
# Cópias de segurança por sessão: 240 MB no ZIP e 384 MB descomprimidos.
COERIA_SESSION_BACKUP_MAX_BYTES=251658240
COERIA_SESSION_BACKUP_MAX_UNCOMPRESSED_BYTES=402653184

# Catálogo visual documental: exame completo, filtragem e seleção equilibrada.
COERIA_MAX_EXTRACTED_IMAGES=30
COERIA_MAX_EXTRACTED_IMAGE_BYTES=5242880
COERIA_MIN_EXTRACTED_IMAGE_WIDTH=240
COERIA_MIN_EXTRACTED_IMAGE_HEIGHT=160
COERIA_MIN_IMAGE_FOOTPRINT_WIDTH_PT=72
COERIA_MIN_IMAGE_FOOTPRINT_HEIGHT_PT=54
COERIA_PDF_COMPOSITE_GAP_PT=18
COERIA_PDF_RENDER_SCALE=2.0

# Gerar também PDF para cada documento LaTeX selecionado pelo docente.
# Instalar previamente os pacotes TeX Live indicados no runbook.
COERIA_LATEX_PDF_ENABLED=true
COERIA_LATEX_COMPILER=/usr/bin/pdflatex
COERIA_LATEX_TIMEOUT_SECONDS=45
