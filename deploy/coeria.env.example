# Copiar para /etc/coeria/coeria.env, preencher no servidor e aplicar modo 0640.
OPENAI_API_KEY=
IAEDU_API_KEY=
COERIA_APP_VERSION=0.2.1
COERIA_AI_PROVIDER=OpenAI
COERIA_DATABASE_PATH=/var/lib/coeria/data/prism.db
COERIA_AUTH_MODE=required
COERIA_ACCESS_FILE=/etc/coeria/access.json
COERIA_STORAGE_SECRET=
NICEGUI_STORAGE_PATH=/var/lib/coeria/nicegui

# Modelo textual OpenAI usado por toda a aplicação.
COERIA_OPENAI_MODEL=gpt-4o-mini
COERIA_OPENAI_RESOURCE_MODEL=gpt-4o-mini
COERIA_OPENAI_CRITIC_MODEL=gpt-4o-mini
COERIA_OPENAI_REASONING_EFFORT=minimal

# Fontes documentais extensas: ingestão bruta e redução automática antes do pipeline.
COERIA_MAX_SOURCE_CHARS=120000
COERIA_MAX_RAW_SOURCE_CHARS=2000000
COERIA_SOURCE_REDUCTION_CHUNK_CHARS=80000
COERIA_SOURCE_REDUCTION_MAX_OUTPUT_TOKENS=2200
COERIA_SOURCE_REDUCTION_MAX_PASSES=3

# Geração opcional de imagens para apresentações (requer consentimento no formulário).
COERIA_OPENAI_IMAGE_MODEL=gpt-image-2
COERIA_OPENAI_IMAGE_SIZE=1536x864
COERIA_OPENAI_IMAGE_QUALITY=low
COERIA_OPENAI_IMAGE_MAX_PER_PRESENTATION=2
