#!/usr/bin/env bash
set -euo pipefail

database='/var/lib/coeria/data/prism.db'
backup_dir='/var/backups/coeria'
timestamp="$(date --utc +'%Y%m%dT%H%M%SZ')"
temporary="$backup_dir/.prism-$timestamp.db"
destination="$backup_dir/prism-$timestamp.db.gz"

install -d -o root -g root -m 0700 "$backup_dir"

if [ ! -f "$database" ]; then
  printf '%s\n' 'No database exists yet; nothing to back up.'
  exit 0
fi

sqlite3 "$database" ".timeout 5000" ".backup '$temporary'"
gzip --no-name "$temporary"
mv "$temporary.gz" "$destination"
chmod 600 "$destination"
find "$backup_dir" -maxdepth 1 -type f -name 'prism-*.db.gz' -mtime +30 -delete

printf 'BACKUP=%s\n' "$destination"
